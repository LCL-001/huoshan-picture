# ====================================================================
# 本地配置模板
#
# 用法：复制为同目录下的 application-local.yaml，再把 replace-me 换成真实值
#   cp src/main/resources/application-local.yaml.example \
#      src/main/resources/application-local.yaml
#
# 说明：
#   - application-local.yaml 已被 backend/.gitignore 忽略，真实密钥不会进版本库
#   - application.yaml 里 spring.profiles.active 默认就是 local，无需额外指定 profile
#   - 每项都写成 ${环境变量:默认值} 形式：默认值用于本地，部署时用环境变量覆盖
#   - 没有默认值的只有 aliYunAi.apiKey：不填应用会启动失败；
#     其余项不填只影响对应功能（COS 缺失 → 图片上传不可用；DB 口令错 → 启动失败）
# ====================================================================

# 腾讯云对象存储：图片上传/下载、头像、空间图片都依赖它
# 密钥获取：https://console.cloud.tencent.com/cam/capi
cos:
  client:
    host: ${COS_HOST:https://replace-me-bucket.cos.ap-guangzhou.myqcloud.com}
    secretId: ${COS_SECRET_ID:replace-me-cos-secret-id}
    secretKey: ${COS_SECRET_KEY:replace-me-cos-secret-key}
    region: ${COS_REGION:ap-guangzhou}
    bucket: ${COS_BUCKET:replace-me-bucket}

# 阿里云百炼：AI 扩图使用
# Key 获取：https://bailian.console.aliyun.com/（DashScope API-KEY）
# 注意：这一项没有默认值，缺失会导致应用启动失败
aliYunAi:
  apiKey: ${ALIYUN_AI_API_KEY:replace-me-dashscope-api-key}

# AI 助手引擎（ai/agent，独立进程，默认 http://localhost:8124/api）的服务间密钥
# 必须与引擎侧 HUOSHAN_HEADLESS_API_KEY（app.huoshan.headless-api-key）填同一个值；
# 不填只影响 AI 助手功能（代理端点一律拒绝），不影响应用启动
app:
  ai:
    assistant:
      internal-api-key: ${AI_ENGINE_INTERNAL_API_KEY:replace-me-internal-only-key}

spring:
  # MySQL 连接地址/用户名/库名见 application.yaml（默认 root@localhost:3306/yu_picture）
  datasource:
    password: ${DB_PASSWORD:replace-me-mysql-password}
  # ShardingSphere 当前未启用（主类 exclude 了它的自动配置），保留此项只为与线上配置结构一致
  shardingsphere:
    datasource:
      yu_picture:
        password: ${DB_PASSWORD:replace-me-mysql-password}
  # 邮件：邮箱验证码、重置密码、绑定邮箱会用到；不测这些功能可以留空
  # password 填邮箱的 SMTP 授权码，不是邮箱登录密码
  mail:
    username: ${MAIL_USERNAME:replace-me@example.com}
    password: ${MAIL_PASSWORD:replace-me-smtp-auth-code}
  # 本地 Redis 若设置了密码，打开下面两行
  # redis:
  #   password: ${REDIS_PASSWORD:}
