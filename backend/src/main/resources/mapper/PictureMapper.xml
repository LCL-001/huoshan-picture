<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lcl.yunpicturebackend.mapper.PictureMapper">
    <resultMap id="BaseResultMap" type="com.lcl.yunpicturebackend.domain.po.Picture">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="url" column="url" jdbcType="VARCHAR"/>
        <result property="thumbnailUrl" column="thumbnailUrl" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="introduction" column="introduction" jdbcType="VARCHAR"/>
        <result property="category" column="category" jdbcType="VARCHAR"/>
        <result property="tags" column="tags" jdbcType="VARCHAR"/>
        <result property="picSize" column="picSize" jdbcType="BIGINT"/>
        <result property="picWidth" column="picWidth" jdbcType="INTEGER"/>
        <result property="picHeight" column="picHeight" jdbcType="INTEGER"/>
        <result property="picScale" column="picScale" jdbcType="DOUBLE"/>
        <result property="picFormat" column="picFormat" jdbcType="VARCHAR"/>
        <result property="userId" column="userId" jdbcType="BIGINT"/>
        <result property="spaceId" column="spaceId" jdbcType="BIGINT"/>
        <result property="reviewStatus" column="reviewStatus" jdbcType="INTEGER"/>
        <result property="reviewMessage" column="reviewMessage" jdbcType="VARCHAR"/>
        <result property="reviewerId" column="reviewerId" jdbcType="BIGINT"/>
        <result property="reviewTime" column="reviewTime" jdbcType="TIMESTAMP"/>
        <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
        <result property="editTime" column="editTime" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
        <result property="isDelete" column="isDelete" jdbcType="INTEGER"/>
        <result property="deleteTime" column="deleteTime" jdbcType="TIMESTAMP"/>

    </resultMap>

    <!-- 回收站（T50）：以下语句是裸 SQL，绕开全局逻辑删除过滤。口径见 PictureMapper 注释 -->

    <select id="selectTrashPage" resultMap="BaseResultMap">
        SELECT * FROM picture
        WHERE isDelete = 1 AND deleteTime IS NOT NULL
        <if test="!all">
            AND (
                (spaceId IS NULL AND userId = #{userId})
                <if test="spaceIds != null and spaceIds.size() > 0">
                    OR spaceId IN
                    <foreach collection="spaceIds" item="sid" open="(" separator="," close=")">#{sid}</foreach>
                </if>
            )
        </if>
        ORDER BY deleteTime DESC, id DESC
    </select>

    <select id="selectTrashedById" resultMap="BaseResultMap">
        SELECT * FROM picture
        WHERE id = #{id} AND isDelete = 1 AND deleteTime IS NOT NULL
    </select>

    <update id="softDeleteById">
        UPDATE picture SET isDelete = 1, deleteTime = NOW()
        WHERE id = #{id} AND isDelete = 0
    </update>

    <update id="restoreTrashedById">
        UPDATE picture SET isDelete = 0, deleteTime = NULL
        WHERE id = #{id} AND isDelete = 1
    </update>

    <delete id="purgeTrashedById">
        DELETE FROM picture WHERE id = #{id} AND isDelete = 1
    </delete>

    <select id="selectExpiredTrash" resultMap="BaseResultMap">
        SELECT * FROM picture
        WHERE isDelete = 1 AND deleteTime IS NOT NULL AND deleteTime &lt; #{deadline}
        ORDER BY deleteTime
        LIMIT #{limit}
    </select>

    <!-- 引用计数（T55）：存活行 + 回收站内可恢复的行都算引用；永久删除（deleteTime 为空）不算 -->
    <select id="countUrlReferences" resultType="long">
        SELECT COUNT(*) FROM picture
        WHERE url = #{url}
          AND (isDelete = 0 OR (isDelete = 1 AND deleteTime IS NOT NULL))
    </select>

</mapper>
