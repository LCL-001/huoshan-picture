# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.sw?

# ===== 日志 =====
*.log
logs/

# ===== AI 模块（ai/agent、ai/image-search-mcp-server）本地件 =====
ai/**/target/
ai/**/.env
ai/**/application-local.yaml
ai/**/application-prod.yaml
ai/**/application-test.yaml

# 引擎工具运行时目录：FileOperationTool/PDFGenerationTool 等会往 <user.dir>/tmp 写文件，
# 跑全模块测试或真机时会产生，属产物而非源码（2026-09-15 补）
ai/**/tmp/

# 浏览器工具（Playwright MCP）的工作目录：页面快照与控制台日志，属产物而非源码（2026-09-16 补）
.playwright-mcp/

# 本地项目讲解与面试准备资料（导学/面经/问答手册）：本机自用、含个人求职相关表述，
# 不进版本库，避免误入公开仓库（2026-09-18 补）
project-guide/

# graphify 代码索引工具的产物与缓存（graph.json / manifest.json / cache/ast/*.json）：
# 工具写到源码根下，属产物而非源码，可随时重建（2026-09-18 补）
graphify-out/

# AI 编码工具（ZCode）的工作目录与忽略配置：会话产物 + 本机工具配置，不进版本库（2026-10-13 补）
.zcode/
.zcodeignore

# AI 编码工具（Serena MCP）的代码索引工作目录：符号缓存 + 本机项目配置，属产物而非源码（2026-10-17 补）
.serena/

# spec-workflow 技能的工作目录（审批 / 规格 / 模板）：工具产物，可随时重建（2026-10-17 补）
.spec-workflow/

# 本机自用的求职材料（自我介绍 / 面试稿）：与 project-guide/ 同理，避免误入公开仓库（2026-10-13 补）
自我介绍*.md
面试*.md
